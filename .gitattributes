# Normalize line endings on the way into git.
#
# CRLF is not cosmetic here: `run_trashbin.sh` reached the UNO Q with CRLF and
# bash rejected it ("line 32: syntax error: unexpected end of file", because
# `done\r` is not `done`). Cron fired the @reboot job, the shell refused the
# file before its first echo, and nothing was logged — the classifier simply
# never came up and it looked like cron had failed. Anything that runs on the
# board or the droplet must be LF.
* text=auto eol=lf

# Binary — never touch these.
*.png   binary
*.jpg   binary
*.stl   binary
*.tflite binary
*.onnx  binary
*.pt    binary
*.ipynb binary
